{
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/health",
      "destination": "/api/health"
    },
    {
      "source": "/api/generate-image",
      "destination": "/api/generate-image"
    },
    {
      "source": "/api/cached-image/(.*)",
      "destination": "/api/cached-image"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
